# Configura la clave aquí, nunca en el código ni en Git.
OPENROUTER_API_KEY=
# Modelo de chat disponible en tu cuenta de OpenRouter.
OPENROUTER_MODEL=deepseek/deepseek-chat
# Opcional. Vacío: búsqueda por palabras; configurado: búsqueda híbrida.
# Usa el mismo modelo para indexar y consultar. Reindexa al cambiarlo.
OPENROUTER_EMBEDDING_MODEL=

# En prueba solo responde a estos contactos, separados por coma.
# Formato: 584121234567@s.whatsapp.net o el JID @lid mostrado en consola.
TEST_MODE=true
ALLOWED_JIDS=
DATA_DIR=./data
AUTH_DIR=./auth_info
KNOWLEDGE_DIR=./knowledge
MAX_DAILY_AI_TURNS=100
