# ==============================================================================
# JUNTALY WHATSAPP BOT - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Clave de API de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de chat disponible en OpenRouter con soporte JSON (ej. deepseek/deepseek-chat, openai/gpt-4o-mini, anthropic/claude-3-haiku)
OPENROUTER_MODEL=deepseek/deepseek-chat

# Modelo de embeddings para búsqueda semántica híbrida (opcional).
# Vacío: usa búsqueda basada en palabras (sin consumo de API al indexar/consultar).
# Si defines uno, reindexa con 'docker compose run --rm bot node src/cli.js ingest'
OPENROUTER_EMBEDDING_MODEL=

# Modo de pruebas (true: solo responde a ALLOWED_JIDS; false: responde a todos los chats directos)
TEST_MODE=true

# Lista de identificadores de WhatsApp autorizados en modo prueba, separados por coma.
# Ejemplos: 584121234567@s.whatsapp.net, 5491123456789@s.whatsapp.net, o identificadores @lid
ALLOWED_JIDS=

# Rutas internas usadas por el contenedor (ya mapeadas por volúmenes en compose)
DATA_DIR=/app/data
AUTH_DIR=/app/auth_info
KNOWLEDGE_DIR=/app/knowledge

# Límite máximo de turnos diarios que consultan IA (protección de presupuesto)
MAX_DAILY_AI_TURNS=100
